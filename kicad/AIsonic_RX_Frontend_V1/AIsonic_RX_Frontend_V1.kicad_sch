(rectangle (start 35.56 119.38) (end 101.6 157.48) (stroke (width 0.3) (type dash) (color 0 100 0 1)) (fill (type none)) (uuid "0025a8cb-e4e7-56a7-83b2-54009570659b"))
(text "虚拟地 VREF=1.65V" (exclude_from_sim no) (at 36.83 122.43 0) (effects (font (size 2.0 2.0) (bold yes) (color 0 100 0 1)) (justify left)) (uuid "dee253f6-eb5a-5282-8291-8d6e836520f3"))
(rectangle (start 193.04 116.84) (end 254.0 149.86) (stroke (width 0.3) (type dash) (color 0 100 0 1)) (fill (type none)) (uuid "a4d9e344-5288-56dc-88cb-40c429c43cf0"))
(text "AGC 控制（STM32 DAC PA4）" (exclude_from_sim no) (at 194.31 119.89 0) (effects (font (size 2.0 2.0) (bold yes) (color 0 100 0 1)) (justify left)) (uuid "fbdd6710-ea5c-5d01-8ceb-6daf52edfaf5"))
(text "VREF15 = AD8338 内部 1.5V 基准" (exclude_from_sim no) (at 259.08 142.24 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "77a2c46b-9166-5087-b83b-4b1bbb181236"))
(text "RX 关键参数：" (exclude_from_sim no) (at 7.62 172.72 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left)) (uuid "d1cdc5a9-b8c7-5170-8b8c-4f3feb62f74b"))
(text "1. 输入信号：mV 级回波；D1 反并联钳位 ±0.3V，D2 将 LNA 输入钳在 GND~3V3" (exclude_from_sim no) (at 7.62 179.07 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "91b309f8-bd21-5ca3-9f6f-65ec5fe8d365"))
(text "2. LNA：同相放大 G = 1 + R3/R4 = 11（+20.8dB），以 VREF=1.65V 为虚拟地" (exclude_from_sim no) (at 7.62 184.15 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "2e99b96a-a4e5-598e-94a5-95e620477c1c"))
(text "3. BPF：多路反馈带通，R5=2.4k / R6=143Ω / R7=4.7k / C3=C4=1nF C0G → f0≈200kHz，Q≈3（BW≈±34kHz），中心增益≈-1" (exclude_from_sim no) (at 7.62 189.23 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "81f88306-475e-5d4a-9bbb-3150a7f8d342"))
(text "4. AD8338：GAIN 0.1~1.1V 对应 0~80dB（12.5mV/dB），MODE=3V3 正斜率；DETO=GND、VAGC=VREF15 关闭内部 AGC" (exclude_from_sim no) (at 7.62 194.31 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "9bb80110-93db-5303-9c7e-e7c950d6c18e"))
(text "5. ADC 驱动：OUTP 经 C14 1uF 交流耦合，R9 10k 偏置到 1.65V → J2.1 → STM32H750 PA0（ADC1）" (exclude_from_sim no) (at 7.62 199.39 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "e6207ed7-80c9-56ec-90c3-c9ec0c2e6e24"))
(text "6. 时序：TX 发送 20 周期后等待 300us 再启动 ADC DMA（2048 点），然后 FFT / 峰值检测 / 距离计算" (exclude_from_sim no) (at 7.62 204.47 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "7acd4b1b-97c8-5b57-81c2-42bc9ab7e3d0"))
